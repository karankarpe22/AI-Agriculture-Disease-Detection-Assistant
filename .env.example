# ==============================================================================
# AI Agriculture Assistant - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and insert your personal keys.
# DO NOT commit your actual '.env' file to GitHub!

# 1. Google Gemini API Key (for AI farmer guidance)
# Obtain a free API key at: https://aistudio.google.com/
# Note: If left blank, the app runs offline using authentic ICAR/TNAU RAG evidence!
GEMINI_API_KEY=

# 2. Weather API Key (Optional)
# Note: If left blank, the app automatically uses Open-Meteo with no key required!
WEATHER_API_KEY=